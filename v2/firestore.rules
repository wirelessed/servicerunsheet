rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Runsheets and all subcollections (users, programme)
    match /runsheets/{runsheetId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      match /{subcollection}/{docId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null;
      }
    }

    // Personal references: users/{email}/runsheets
    match /users/{userEmailId}/runsheets/{runsheetId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Groups
    match /groups/{groupId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Group tokens
    match /groupTokens/{tokenId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
