rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: runsheets
// Document ID: Auto-generated
// Fields:
//   - name: string (required, max 500 chars) - runsheet title
//   - date: string (optional, max 20 chars) - ISO date string
//   - time: string (optional, max 10 chars) - "HHmm" format
//   - category: string (required, 'active' | 'archive')
//   - groupId: string|null (optional, max 100 chars) - FK to groups
//   - orderCount: number (optional) - legacy ordering
//   - lastUpdated: string (optional, max 50 chars) - moment ISO string
//   - notes: string (optional, max 50000 chars) - HTML from rich editor
//   - memberEmails: list (required) - array of member email strings
//   - roles: map (required) - { email: role } mapping
//
// Subcollection: runsheets/{id}/users
// Document ID: email address
// Fields:
//   - id: string (required) - email address (same as doc ID)
//   - email: string (required) - email address
//   - role: string (required) - 'owner' | 'editor' | 'ops' | 'viewer'
//   - addedAt: string (optional) - ISO date string
//   - addedBy: string (optional) - email of who added them
//
// Subcollection: runsheets/{id}/programme
// Document ID: Auto-generated
// Fields:
//   - text: string (optional, max 1000 chars) - item title
//   - remarks: string (optional, max 10000 chars) - description
//   - duration: number (optional) - minutes
//   - location: string (optional, max 500 chars)
//   - links: list (optional, max 20 items) - link objects
//   - orderCount: number (optional) - sort order
//   - originalDuration: number (optional) - planned duration
//
// Collection: users/{email}/runsheets
// Document ID: runsheet ID
// Fields:
//   - id: string (required) - runsheet ID
//   - role: string (optional) - role string
//   - sharedBy: string (optional) - email of sharer
//   - sharedAt: string (optional) - ISO date string
//
// Collection: groups
// Document ID: Auto-generated
// Fields:
//   - name: string (required, max 200 chars) - group name
//   - createdBy: string (required) - email of creator
//   - createdAt: string (optional, max 50 chars)
//   - archived: bool (optional)
//
// Collection: groupTokens
// Document ID: share token string
// Fields:
//   - groupId: string (required) - FK to groups collection
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the authenticated user's email
    function userEmail() {
      return request.auth.token.email.lower();
    }

    // Validate required fields exist in the incoming data
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate document only contains allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Check if a field was not modified in an update
    function fieldUnchanged(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == resource.data[field];
    }

    // Check which fields were actually changed
    function onlyTheseFieldsChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Valid role values
    function isValidRole(role) {
      return role in ['owner', 'editor', 'ops', 'viewer'];
    }

    // Valid category values
    function isValidCategory(category) {
      return category in ['active', 'archive'];
    }

    // ===============================================================
    // Runsheet-level role lookups
    // ===============================================================

    // Get a user's role from the runsheet's users subcollection
    function getUserRole(runsheetId, email) {
      return get(/databases/$(database)/documents/runsheets/$(runsheetId)/users/$(email)).data.role;
    }

    // Check if a user has a role document in the runsheet
    function hasUserRole(runsheetId, email) {
      return exists(/databases/$(database)/documents/runsheets/$(runsheetId)/users/$(email));
    }

    function getUserRoleFromMap(runsheetId) {
      let rolesMap = get(/databases/$(database)/documents/runsheets/$(runsheetId)).data.get('roles', {});
      return rolesMap.get(userEmail(), rolesMap.get(request.auth.token.email, null));
    }

    // Check if user is the runsheet owner
    function isRunsheetOwner(runsheetId) {
      return isAuthenticated() && (
        (hasUserRole(runsheetId, userEmail()) && getUserRole(runsheetId, userEmail()) == 'owner') ||
        (hasUserRole(runsheetId, request.auth.token.email) && getUserRole(runsheetId, request.auth.token.email) == 'owner') ||
        getUserRoleFromMap(runsheetId) == 'owner'
      );
    }

    // Check if user is an editor (owner or editor role)
    function isRunsheetEditor(runsheetId) {
      return isAuthenticated() && (
        (hasUserRole(runsheetId, userEmail()) && getUserRole(runsheetId, userEmail()) in ['owner', 'editor']) ||
        (hasUserRole(runsheetId, request.auth.token.email) && getUserRole(runsheetId, request.auth.token.email) in ['owner', 'editor']) ||
        getUserRoleFromMap(runsheetId) in ['owner', 'editor']
      );
    }

    // Check if user is ops
    function isRunsheetOps(runsheetId) {
      return isAuthenticated() && (
        (hasUserRole(runsheetId, userEmail()) && getUserRole(runsheetId, userEmail()) == 'ops') ||
        (hasUserRole(runsheetId, request.auth.token.email) && getUserRole(runsheetId, request.auth.token.email) == 'ops') ||
        getUserRoleFromMap(runsheetId) == 'ops'
      );
    }

    // Check if user is a member (any role)
    function isRunsheetMember(runsheetId) {
      return isAuthenticated() && (
        hasUserRole(runsheetId, userEmail()) ||
        hasUserRole(runsheetId, request.auth.token.email) ||
        userEmail() in get(/databases/$(database)/documents/runsheets/$(runsheetId)).data.get('roles', {}).keys() ||
        request.auth.token.email in get(/databases/$(database)/documents/runsheets/$(runsheetId)).data.get('roles', {}).keys()
      );
    }

    // ===============================================================
    // Collection: runsheets
    // ===============================================================
    match /runsheets/{runsheetId} {

      // --- Validation ---
      function isValidRunsheetCreate() {
        let data = request.resource.data;
        return hasRequiredFields(['name', 'category', 'memberEmails', 'roles']) &&
          hasOnlyAllowedFields(['name', 'date', 'time', 'category', 'groupId',
            'orderCount', 'lastUpdated', 'notes', 'memberEmails', 'roles', 'shareToken']) &&
          isValidCategory(data.category) &&
          data.memberEmails is list &&
          data.roles is map &&
          // Creator must be in memberEmails and have owner role
          userEmail() in data.memberEmails &&
          data.roles[userEmail()] == 'owner';
      }

      function isValidRunsheetUpdate() {
        let data = request.resource.data;
        return hasOnlyAllowedFields(['name', 'date', 'time', 'category', 'groupId',
            'orderCount', 'lastUpdated', 'notes', 'memberEmails', 'roles', 'shareToken']) &&
          (!('category' in data) || isValidCategory(data.category)) &&
          (!('memberEmails' in data) || data.memberEmails is list) &&
          (!('roles' in data) || data.roles is map);
      }

      // READ: Anyone can read a runsheet if they have the ID.
      // This supports unauthenticated access for print pages, share links,
      // and direct runsheet links. The dashboard query uses
      // where('memberEmails', 'array-contains', email) to scope results.
      allow read: if true;

      // CREATE: Any authenticated user can create a runsheet (they become owner)
      allow create: if isAuthenticated() && isValidRunsheetCreate();

      // UPDATE: Editors can update metadata; members can update memberEmails/roles
      // for enrollment purposes (adding themselves as viewer).
      // Also anyone can set shareToken if it is currently missing.
      allow update: if (
        // Case 0: Allow setting shareToken if it is currently missing (bypasses full doc validation)
        onlyTheseFieldsChanged(['shareToken']) &&
        (!('shareToken' in resource.data) || resource.data.shareToken == null) &&
        request.resource.data.shareToken is string &&
        request.resource.data.shareToken.size() == 6
      ) || (
        isValidRunsheetUpdate() && (
          isAuthenticated() && (
            // Case 1: Editors can update any allowed field
            isRunsheetEditor(runsheetId) ||

            // Case 2: Ops can only update lastUpdated (for logging transitions)
            (isRunsheetOps(runsheetId) &&
              onlyTheseFieldsChanged(['lastUpdated'])) ||

            // Case 3: Self-enrollment as viewer — authenticated user adds ONLY
            // themselves to memberEmails and roles with 'viewer' role.
            // This supports the auto-enrollment flow from /runsheet/ and /share/ pages.
            (onlyTheseFieldsChanged(['memberEmails', 'roles']) &&
              // User must be adding themselves (new email in memberEmails)
              userEmail() in request.resource.data.memberEmails &&
              // User must be setting their own role to 'viewer' only
              request.resource.data.roles[userEmail()] == 'viewer' &&
              // All previous members must still be present
              resource.data.memberEmails.hasAll(
                request.resource.data.memberEmails.removeAll([userEmail()])
                    .removeAll([userEmail()])) &&
              // All previous roles must be unchanged (only the new user's role is added)
              resource.data.roles.keys().hasAll(
                request.resource.data.roles.keys().removeAll([userEmail()])))
          )
        )
      );

      // DELETE: Only the owner can delete a runsheet
      allow delete: if isRunsheetOwner(runsheetId);


      // =============================================================
      // Subcollection: runsheets/{id}/users
      // =============================================================
      match /users/{memberEmail} {

        function isValidUserDoc() {
          let data = request.resource.data;
          return hasRequiredFields(['id', 'email', 'role']) &&
            hasOnlyAllowedFields(['id', 'email', 'role', 'addedAt', 'addedBy']) &&
            data.id == memberEmail &&
            data.email == memberEmail &&
            isValidRole(data.role);
        }

        // READ: Members can read user docs for their runsheet
        allow read: if isRunsheetMember(runsheetId) ||
          // Allow authenticated users to check their own membership
          (isAuthenticated() && memberEmail == userEmail());

        // CREATE:
        allow create: if isAuthenticated() && isValidUserDoc() && (
          // Case 1: Editors/owners can add any user with any role (except owner)
          (isRunsheetEditor(runsheetId) && request.resource.data.role != 'owner') ||

          // Case 2: Self-enrollment — user adds themselves as viewer only
          (memberEmail == userEmail() && request.resource.data.role == 'viewer') ||

          // Case 3: Creator adding themselves as owner during runsheet creation
          // (uses getAfter to check the runsheet doc being created in the same batch)
          (memberEmail == userEmail() && request.resource.data.role == 'owner' &&
            getAfter(/databases/$(database)/documents/runsheets/$(runsheetId)).data.roles[userEmail()] == 'owner')
        );

        // UPDATE:
        allow update: if isAuthenticated() && isValidUserDoc() && (
          // Only owners can change roles
          (isRunsheetOwner(runsheetId) &&
            // Cannot change the owner's own role document to non-owner
            // (prevents owner from accidentally demoting themselves via this path)
            (memberEmail != userEmail() || request.resource.data.role == 'owner')) ||

          // Self-healing: a user can update their own doc if role stays the same
          (memberEmail == userEmail() && fieldUnchanged('role'))
        );

        // DELETE: Only editors/owners can remove users (but not the owner)
        allow delete: if isRunsheetEditor(runsheetId) &&
          // Cannot remove the owner
          resource.data.role != 'owner';
      }


      // =============================================================
      // Subcollection: runsheets/{id}/programme
      // =============================================================
      match /programme/{itemId} {

        function isValidProgrammeItem() {
          let data = request.resource.data;
          return hasOnlyAllowedFields(['text', 'remarks', 'duration', 'location',
              'links', 'orderCount', 'originalDuration']) &&
            (!('links' in data) || data.links is list);
        }

        // READ: Anyone can read programme items (supports print page
        // and unauthenticated runsheet viewing)
        allow read: if true;

        // CREATE: Only editors can add items
        allow create: if isRunsheetEditor(runsheetId) && isValidProgrammeItem();

        // UPDATE: Editors can update all fields; Ops can only update duration fields
        allow update: if isValidProgrammeItem() && (
          isRunsheetEditor(runsheetId) ||
          // Ops: can only change duration and originalDuration (for logging transitions)
          (isRunsheetOps(runsheetId) &&
            onlyTheseFieldsChanged(['duration', 'originalDuration']))
        );

        // DELETE: Only editors can delete items
        allow delete: if isRunsheetEditor(runsheetId);
      }
    }


    // ===============================================================
    // Collection: users/{email}/runsheets (personal references)
    // ===============================================================
    match /users/{userEmailId}/runsheets/{runsheetId} {

      function isValidUserRunsheetRef() {
        let data = request.resource.data;
        return hasRequiredFields(['id']) &&
          hasOnlyAllowedFields(['id', 'role', 'sharedBy', 'sharedAt']) &&
          data.id == runsheetId &&
          (!('role' in data) || isValidRole(data.role));
      }

      // READ: Users can only read their own personal references
      allow read: if isAuthenticated() && userEmail() == userEmailId;

      // CREATE: An authenticated user can create a ref in their own collection,
      // OR an editor can create a ref in another user's collection (sharing)
      allow create: if isAuthenticated() && isValidUserRunsheetRef() && (
        // Self-enrollment or runsheet creation
        userEmail() == userEmailId ||
        // Editor sharing with another user
        isRunsheetEditor(runsheetId)
      );

      // UPDATE: Owner of the ref can update, or an editor on the runsheet
      allow update: if isAuthenticated() && isValidUserRunsheetRef() && (
        userEmail() == userEmailId ||
        isRunsheetEditor(runsheetId)
      );

      // DELETE: Owner of the ref can delete, or an editor on the runsheet
      // (for when removing a user from a runsheet)
      allow delete: if isAuthenticated() && (
        userEmail() == userEmailId ||
        isRunsheetEditor(runsheetId)
      );
    }


    // ===============================================================
    // Collection: groups
    // ===============================================================
    match /groups/{groupId} {

      function isValidGroupCreate() {
        let data = request.resource.data;
        return hasRequiredFields(['name', 'createdBy']) &&
          hasOnlyAllowedFields(['name', 'createdBy', 'createdAt', 'archived', 'shareToken']) &&
          data.createdBy == userEmail();
      }

      function isValidGroupUpdate() {
        return hasOnlyAllowedFields(['name', 'createdBy', 'createdAt', 'archived', 'shareToken']) &&
          // createdBy is immutable
          fieldUnchanged('createdBy');
      }

      // Check if user is the group creator
      function isGroupOwner() {
        return isAuthenticated() && resource.data.createdBy == userEmail();
      }

      // READ: Anyone can read group metadata.
      // This supports the public /group/[token] page which shows group info
      // and its runsheets without requiring authentication.
      allow read: if true;

      // CREATE: Any authenticated user can create a group
      allow create: if isAuthenticated() && isValidGroupCreate();

      // UPDATE: Only the group creator can update, or anyone can set shareToken if currently missing
      allow update: if isValidGroupUpdate() && (
        isGroupOwner() ||
        (onlyTheseFieldsChanged(['shareToken']) &&
          (!('shareToken' in resource.data) || resource.data.shareToken == null))
      );

      // DELETE: Only the group creator can delete
      allow delete: if isGroupOwner();
    }


    // ===============================================================
    // Collection: groupTokens (read-only from client)
    // ===============================================================
    match /groupTokens/{tokenId} {

      // READ: Anyone can resolve group tokens
      allow read: if true;

      // Anyone can register a token lookup pointing to a valid group
      allow create: if request.resource.data.keys().hasOnly(['groupId']) &&
        request.resource.data.groupId is string &&
        exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId));

      allow update, delete: if false;
    }


    // ===============================================================
    // Default deny — catch-all for any unmatched paths
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
